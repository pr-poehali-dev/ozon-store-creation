{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Пустые обязательные поля",
      "method": "POST",
      "path": "/",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "GET без токена и без email/user_id — 401",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401
    },
    {
      "name": "GET история заказов по email",
      "method": "GET",
      "path": "/?email=test@example.com",
      "expectedStatus": 200,
      "expectedBody": { "orders": [] },
      "bodyMatcher": "partial"
    },
    {
      "name": "GET с токеном — список заказов",
      "method": "GET",
      "path": "/",
      "headers": { "X-Admin-Token": "polimer-admin-2024" },
      "expectedStatus": 200,
      "expectedBody": { "orders": [] },
      "bodyMatcher": "partial"
    }
  ]
}