{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Пустые обязательные поля",
      "method": "POST",
      "path": "/",
      "body": {},
      "expectedStatus": 400
    },
    {
      "name": "Несуществующий товар",
      "method": "POST",
      "path": "/",
      "body": {
        "name": "Тест",
        "phone": "+79990000000",
        "email": "t@example.com",
        "delivery": "pickup",
        "items": [
          {
            "id": 99999,
            "quantity": 1
          }
        ]
      },
      "expectedStatus": 400
    },
    {
      "name": "GET без токена — 401",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401
    },
    {
      "name": "GET по чужому email без токена — 401",
      "method": "GET",
      "path": "/?email=test@example.com",
      "expectedStatus": 401
    },
    {
      "name": "GET со старым паролем админа — 401",
      "method": "GET",
      "path": "/",
      "headers": {
        "X-Admin-Token": "polimer-admin-2024"
      },
      "expectedStatus": 401
    },
    {
      "name": "PUT без токена — 401",
      "method": "PUT",
      "path": "/",
      "body": {
        "id": 1,
        "status": "shipped"
      },
      "expectedStatus": 401
    }
  ]
}