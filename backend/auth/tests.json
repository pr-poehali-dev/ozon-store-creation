{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Вход с неверным паролем",
      "method": "POST",
      "path": "/",
      "body": {"action": "login", "email": "no_such_user@example.com", "password": "wrongpass"},
      "expectedStatus": 401
    },
    {
      "name": "Вход админа с неверным паролем",
      "method": "POST",
      "path": "/",
      "body": {"action": "admin_login", "password": "definitely-wrong-password"},
      "expectedStatus": 401
    },
    {
      "name": "Неизвестное действие",
      "method": "POST",
      "path": "/",
      "body": {"action": "nope"},
      "expectedStatus": 400
    }
  ]
}
